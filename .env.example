# ==============================================================================
# SARA AI 2.5 PRO — SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your personal API keys and contact details.
# ==============================================================================

# Core Intelligence APIs
GEMINI_API_KEY=your_gemini_api_key_here
APINEX_API_KEY=your_apinex_api_key_here
APINEX_BASE_URL=https://api.apinex.bond/v1

# SARA AI 2.5 PRO - TOP VERIFIED WORKING APINEX MODELS (LIVE BENCHMARK AUDITED)
# 1. free/glm-5.3-flashx          (Rank 1: Fastest Interactive Chat ~1216ms)
# 2. free/gemini-3.8-flash        (Rank 2: Poetic Urdu & Multimodal Knowledge ~1320ms)
# 3. free/deepseek-v4-pro-0813    (Rank 3: Supreme Architecture & Deep Reasoning ~1369ms)
# 4. free/gpt-6-luna              (Rank 4: Smooth Natural Language Generation ~1417ms)
# 5. free/minimax-m3.1-flash      (Rank 5: Expressive Personality & Fast Dialogue ~1598ms)
# 6. free/kimi-k3                 (Rank 6: 1M Context Document Research & File Analysis ~1750ms)
# 7. free/deepseek-v4.1-flash     (Rank 7: High-Precision Python/Node/TS Code Gen ~2060ms)

SARA_TOP_7_MODELS=free/glm-5.3-flashx,free/gemini-3.8-flash,free/deepseek-v4-pro-0813,free/gpt-6-luna,free/minimax-m3.1-flash,free/kimi-k3,free/deepseek-v4.1-flash

# Task-Specific Multi-Tier Routing (Zero 402 Latency Retries):
SARA_CHAT_MODEL=free/glm-5.3-flashx,free/gemini-3.8-flash,free/gpt-6-luna,gemini-3.5-flash
SARA_FAST_MODEL=free/glm-5.3-flashx,free/gemini-3.8-flash,free/minimax-m3.1-flash,gemini-3.5-flash
SARA_CODE_MODEL=free/deepseek-v4-pro-0813,free/deepseek-v4.1-flash,free/glm-5.3-flashx,gemini-3.5-flash
SARA_REASONING_MODEL=free/deepseek-v4-pro-0813,free/kimi-k3,free/gemini-3.8-flash,gemini-3.5-flash
SARA_RESEARCH_MODEL=free/kimi-k3,free/deepseek-v4-pro-0813,free/gemini-3.8-flash,gemini-3.5-flash
SARA_VISION_MODEL=gemini-3.8-live
SARA_SPEECH_MODEL=gemini-3.8-live
SARA_VOICE_NAME=Kore

# Server & Network Configuration
PORT=3344
HUGGINGFACE_API_KEY=

# User Profile & Verified Contacts
USER_EMAIL=user@example.com
USER_PHONE=+923000000000

# Autonomous Desktop Capabilities
SARA_ENABLE_SCREEN_AWARENESS=true
SARA_ENABLE_DESKTOP_AWARENESS=true

